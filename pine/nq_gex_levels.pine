//@version=6
// NQ GEX Levels: call wall, put wall, zero gamma, a GEX bar column and the gamma regime, drawn from text pasted
// into the settings (the "Copy GEX levels" shortcut puts it on your clipboard). Works on NQ and MNQ charts: levels
// are measured from the chart's own price at the data's as-of time.
// New inputs go at the END of the list (TradingView keeps saved values by position), but they still show up inside
// their own group. To add a new level later: one input row, one line in `addLevel`, and one key in the paste text.
indicator("NQ GEX Levels", "GEX", overlay = true, max_lines_count = 100, max_labels_count = 300, max_boxes_count = 200)

//#region ───── Inputs
string G_DATA = "Data"
string G_LVL  = "Levels"
string G_BAR  = "Gamma bars"
string G_REG  = "Regime"
string G_STY  = "Style"

// Data
string pasteIn = input.text_area("", "Paste levels", group = G_DATA, tooltip = "Run the 'Copy GEX levels' shortcut, then click this box, press Ctrl+A, then Ctrl+V.")
string setIn   = input.string("WIDE", "Expiry set", ["NEAR", "WIDE"], group = G_DATA, tooltip = "NEAR = expiries up to 7 days out. WIDE = up to 45 days out.")

// Levels: one row each (show + colour). Colours are the same family as the SVP indicator.
bool  showCw = input.bool(true,  "Call wall",   inline = "cw", group = G_LVL)
color cCw    = input.color(#F23645, "",         inline = "cw", group = G_LVL)
bool  showPw = input.bool(true,  "Put wall",    inline = "pw", group = G_LVL)
color cPw    = input.color(#089981, "",         inline = "pw", group = G_LVL)
bool  showZg = input.bool(true,  "Zero gamma",  inline = "zg", group = G_LVL)
color cZg    = input.color(#B2B5BE, "",         inline = "zg", group = G_LVL)
bool  zoneZg = input.bool(true,  "Zone",        inline = "zg", group = G_LVL, tooltip = "Draw zero gamma as a soft band instead of a line.")
bool  showTp = input.bool(false, "Top strikes (G1 to G5)", inline = "tp", group = G_LVL)
color cTp    = input.color(#787B86, "",         inline = "tp", group = G_LVL)
bool  showEm = input.bool(false, "1D range (max / min)",   inline = "em", group = G_LVL)
color cEm    = input.color(#FFB74D, "",         inline = "em", group = G_LVL)

// Gamma bars
bool  showBar = input.bool(true, "Show",          inline = "b0", group = G_BAR, tooltip = "Net GEX at each price, drawn to the right of the last candle. Needs empty space on the right: drag the chart left.")
color cBarPos = input.color(#089981, "Positive",  inline = "b1", group = G_BAR)
color cBarNeg = input.color(#F23645, "Negative",  inline = "b1", group = G_BAR)
int   offIn   = input.int(14, "Start (bars right of price)", minval = 3, maxval = 200, group = G_BAR, tooltip = "Leave room for the level labels.")
int   widIn   = input.int(30, "Width (bars)", minval = 5, maxval = 150, group = G_BAR)
int   lblPct  = input.int(15, "Label bars bigger than (% of biggest)", minval = 0, maxval = 100, group = G_BAR)

// Regime
bool   showReg = input.bool(true, "Show regime line", group = G_REG, tooltip = "One small line: positive or negative gamma and when the data is from.")
string regPos  = input.string("Top left", "Position", ["Top left", "Top right", "Bottom left", "Bottom right"], group = G_REG)
float  movedIn = input.float(0.75, "Warn when NQ has moved (%) since the data", minval = 0.1, step = 0.05, group = G_REG)

// Style
string lblStyle = input.string("Tag", "Labels", ["Tag", "Text"], group = G_STY, tooltip = "Tag = small filled tag like a price-scale label. Text = coloured text only, like the SVP labels.")
string lblSize  = input.string("tiny", "Label size", ["tiny", "small", "normal"], group = G_STY)
bool   fullIn   = input.bool(true, "Lines span the whole chart", group = G_STY, tooltip = "Off = lines start at the data's as-of time.")
float  mergeIn  = input.float(1.0, "Merge labels closer than (points)", minval = 0.0, step = 0.25, group = G_STY)
float  zoneIn   = input.float(12.0, "Zero gamma band half-height (points)", minval = 1.0, step = 1.0, group = G_STY)
//#endregion

//#region ───── Helpers
fmtK(float k) =>
    float a = math.abs(k)
    string s = a >= 1000000 ? str.tostring(a / 1000000, "#.#") + "B" : a >= 1000 ? str.tostring(a / 1000, "#.#") + "M" : str.tostring(a, "#") + "K"
    (k < 0 ? "-" : "") + s

addLevel(array<float> px, array<string> nm, array<color> col, float p, string n, color c) =>
    if not na(p)
        array.push(px, p)
        array.push(nm, n)
        array.push(col, c)

tablePos(string s) =>
    switch s
        "Top right"    => position.top_right
        "Bottom left"  => position.bottom_left
        "Bottom right" => position.bottom_right
        => position.top_left
//#endregion

//#region ───── Parse the pasted text once
var int    genMs    = na
var int    anchorMs = na
var int    nextMs   = na
var string regime   = ""
var float  flipD    = na
var float  cwD      = na
var float  pwD      = na
var float  emD      = na
var array<float> topD  = array.new<float>()
var array<float> profD = array.new<float>()
var array<float> profV = array.new<float>()
var string problem = ""

if barstate.isfirst
    bool header = false
    int blocks = 0
    bool inSet = false
    bool found = false
    array<string> rows = str.split(pasteIn, "\n")
    for raw in rows
        string t = str.trim(raw)
        if t != ""
            array<string> p = str.split(t, " ")
            string k = array.get(p, 0)
            string v = array.size(p) > 1 ? array.get(p, 1) : ""
            if k == "GEX1"
                header := true
                blocks += 1
            else if k == "gen"
                genMs := int(str.tonumber(v))
            else if k == "anchor"
                anchorMs := int(str.tonumber(v))
            else if k == "next"
                nextMs := int(str.tonumber(v))
            else if k == "set"
                inSet := v == setIn
                found := found or inSet
            else if inSet
                if k == "reg"
                    regime := v
                else if k == "flip"
                    flipD := str.tonumber(v)
                else if k == "cw"
                    cwD := str.tonumber(v)
                else if k == "pw"
                    pwD := str.tonumber(v)
                else if k == "em"
                    emD := str.tonumber(v)
                else if k == "top"
                    if array.size(p) > 1
                        for i = 1 to array.size(p) - 1
                            array<string> kv = str.split(array.get(p, i), ":")
                            if array.size(kv) > 1
                                float tDist = str.tonumber(array.get(kv, 0))
                                if not na(tDist)
                                    array.push(topD, tDist)
                else if k == "prof"
                    if array.size(p) > 1
                        for i = 1 to array.size(p) - 1
                            array<string> kv = str.split(array.get(p, i), ":")
                            if array.size(kv) > 1
                                // a half-pasted number (300: or 300:abc) drops only its own bar
                                float pDist = str.tonumber(array.get(kv, 0))
                                float pVal = str.tonumber(array.get(kv, 1))
                                if not na(pDist) and not na(pVal)
                                    array.push(profD, pDist)
                                    array.push(profV, pVal)
    if str.trim(pasteIn) == ""
        problem := "Paste the levels from the 'Copy GEX levels' shortcut: open this indicator's settings (Inputs tab), click the Paste levels box, press Ctrl+A, then Ctrl+V."
    else if not header or na(anchorMs) or na(genMs) or na(nextMs)
        problem := "Could not read the pasted text. Run the shortcut again, click the box, press Ctrl+A, then Ctrl+V."
    else if blocks > 1
        problem := "The box holds more than one block of levels. Click the box, press Ctrl+A, then Ctrl+V."
    else if not found
        problem := "Expiry set " + setIn + " was not found in the pasted text."
//#endregion

//#region ───── The chart's own price at the data's as-of time
// The last bar that closes at or before the as-of time is the anchor, but only if it ends within 15 minutes of it. A bar that ends
// earlier (a 45-minute bar, or a daily bar that ends at 17:00 ET) does not hold the price at the as-of time: draw nothing and say so.
int MAX_GAP_MS = 15 * 60 * 1000
var float anchorPx    = na
var int   anchorBar   = na
var int   anchorClose = na
if problem == "" and time_close <= anchorMs
    anchorClose := time_close
    anchorPx := anchorMs - time_close > MAX_GAP_MS ? na : close
    anchorBar := bar_index
//#endregion

//#region ───── Price-scale tags (labels on the price scale only, no extra lines)
plot(showCw ? anchorPx + cwD : na, "Call wall", cCw, display = display.price_scale)
plot(showPw ? anchorPx + pwD : na, "Put wall", cPw, display = display.price_scale)
plot(showZg ? anchorPx + flipD : na, "Zero gamma", cZg, display = display.price_scale)
plot(showEm ? anchorPx + emD : na, "1D Max", cEm, display = display.price_scale)
plot(showEm ? anchorPx - emD : na, "1D Min", cEm, display = display.price_scale)
//#endregion

//#region ───── Drawing
var array<line>  lns = array.new<line>()
var array<label> lbs = array.new<label>()
var array<box>   bxs = array.new<box>()
var table banner = table.new(tablePos(regPos), 1, 2, frame_width = 0, border_width = 0)

if barstate.islast
    for l in lns
        line.delete(l)
    array.clear(lns)
    for b in lbs
        label.delete(b)
    array.clear(lbs)
    for x in bxs
        box.delete(x)
    array.clear(bxs)

    string sizeStr = lblSize == "small" ? size.small : lblSize == "normal" ? size.normal : size.tiny
    color dark = #131722
    color red = color.new(#B71C1C, 10)

    if problem != ""
        table.cell(banner, 0, 0, problem, text_color = color.white, bgcolor = red, text_halign = text.align_left)
        table.cell(banner, 0, 1, "")
    else if na(anchorPx)
        string msg = na(anchorClose) ? "This chart has no bar at the data's as-of time. Use a 15-minute or shorter chart and scroll back, or paste newer levels." : "This chart's bars do not end at the data's as-of time (" + str.format_time(anchorMs, "HH:mm", "America/New_York") + " ET). Use a 15-minute or shorter chart, or paste newer levels."
        table.cell(banner, 0, 0, msg, text_color = color.white, bgcolor = red, text_halign = text.align_left)
        table.cell(banner, 0, 1, "")
    else
        // 1) levels in priority order
        array<float> lvPx = array.new<float>()
        array<string> lvNm = array.new<string>()
        array<color> lvCol = array.new<color>()
        if showCw
            addLevel(lvPx, lvNm, lvCol, anchorPx + cwD, "Call Wall", cCw)
        if showPw
            addLevel(lvPx, lvNm, lvCol, anchorPx + pwD, "Put Wall", cPw)
        if showZg
            addLevel(lvPx, lvNm, lvCol, anchorPx + flipD, "Zero Gamma", cZg)
        if showEm
            addLevel(lvPx, lvNm, lvCol, anchorPx + emD, "1D Max", cEm)
            addLevel(lvPx, lvNm, lvCol, anchorPx - emD, "1D Min", cEm)
        if showTp and array.size(topD) > 0
            // rank the top strikes by the size of their bar: G1 is the biggest
            array<float> mags = array.new<float>()
            for i = 0 to array.size(topD) - 1
                float pv = na
                if array.size(profD) > 0
                    for j = 0 to array.size(profD) - 1
                        if array.get(profD, j) == array.get(topD, i)
                            pv := array.get(profV, j)
                array.push(mags, na(pv) ? 0.0 : math.abs(pv))
            array<int> ranked = array.sort_indices(mags, order.descending)
            for r = 0 to array.size(ranked) - 1
                int idx = array.get(ranked, r)
                addLevel(lvPx, lvNm, lvCol, anchorPx + array.get(topD, idx), "G" + str.tostring(r + 1), cTp)

        // 2) merge labels that sit on the same price into one tag
        array<float> bPx = array.new<float>()
        array<string> bTxt = array.new<string>()
        array<color> bCol = array.new<color>()
        array<bool> bBand = array.new<bool>()
        if array.size(lvPx) > 0
            for i = 0 to array.size(lvPx) - 1
                int hit = -1
                if array.size(bPx) > 0
                    for j = 0 to array.size(bPx) - 1
                        if hit < 0 and math.abs(array.get(bPx, j) - array.get(lvPx, i)) <= mergeIn
                            hit := j
                if hit >= 0
                    array.set(bTxt, hit, array.get(bTxt, hit) + " | " + array.get(lvNm, i))
                else
                    array.push(bPx, array.get(lvPx, i))
                    array.push(bTxt, array.get(lvNm, i))
                    array.push(bCol, array.get(lvCol, i))
                    array.push(bBand, zoneZg and array.get(lvNm, i) == "Zero Gamma")

        // 3) lines and labels (zero gamma is a band when 'Zone' is on, so it gets no line)
        if array.size(bPx) > 0
            for i = 0 to array.size(bPx) - 1
                float y = array.get(bPx, i)
                color c = array.get(bCol, i)
                if not array.get(bBand, i)
                    array.push(lns, line.new(anchorBar, y, anchorBar + 1, y, xloc.bar_index, fullIn ? extend.both : extend.right, c, line.style_solid, 1))
                if lblStyle == "Tag"
                    array.push(lbs, label.new(bar_index + 2, y, array.get(bTxt, i), xloc.bar_index, yloc.price, c, label.style_label_left, dark, sizeStr))
                else
                    array.push(lbs, label.new(bar_index + 2, y, array.get(bTxt, i), xloc.bar_index, yloc.price, color(na), label.style_label_left, c, sizeStr))

        // 4) zero gamma band
        if showZg and zoneZg and not na(flipD)
            float fy = anchorPx + flipD
            int left = fullIn ? math.max(0, bar_index - 4999) : anchorBar
            array.push(bxs, box.new(left, fy + zoneIn, bar_index + 1, fy - zoneIn, border_color = color(na), bgcolor = color.new(cZg, 80), extend = extend.right))

        // 5) the gamma bar column on the right
        if showBar and array.size(profD) > 0
            float maxAbs = 0.0
            for v in profV
                maxAbs := math.max(maxAbs, math.abs(v))
            if maxAbs > 0
                for i = 0 to array.size(profD) - 1
                    float v = array.get(profV, i)
                    float y = anchorPx + array.get(profD, i)
                    int len = int(math.max(1, math.round(math.abs(v) / maxAbs * widIn)))
                    int x1 = bar_index + offIn
                    array.push(bxs, box.new(x1, y + 7.5, x1 + len, y - 7.5, border_color = color(na), bgcolor = color.new(v >= 0 ? cBarPos : cBarNeg, 35)))
                    if math.abs(v) >= maxAbs * lblPct / 100.0
                        array.push(lbs, label.new(x1 + len + 1, y, fmtK(v), xloc.bar_index, yloc.price, color(na), label.style_label_left, color.new(v >= 0 ? cBarPos : cBarNeg, 0), size.tiny))

        // 6) regime line (small) and warnings (only when needed)
        int mins = int((timenow - genMs) / 60000)
        string age = mins < 90 ? str.tostring(mins) + " min old" : str.tostring(mins / 60.0, "#.#") + " h old"
        string gam = regime == "P" ? "Positive gamma" : "Negative gamma"
        color gamCol = regime == "P" ? cBarPos : cBarNeg
        if showReg
            table.cell(banner, 0, 0, gam + "  |  " + setIn + "  |  data " + str.format_time(genMs, "HH:mm", "America/New_York") + " ET (" + age + ")", text_color = gamCol, text_size = size.small, text_halign = text.align_left)
        else
            table.cell(banner, 0, 0, "")
        bool stale = timenow > nextMs
        float movedPct = math.abs(close / anchorPx - 1) * 100
        if stale
            table.cell(banner, 0, 1, "STALE: paste fresh levels (due " + str.format_time(nextMs, "HH:mm", "America/New_York") + " ET)", text_color = color.white, bgcolor = red, text_size = size.small, text_halign = text.align_left)
        else if movedPct > movedIn
            table.cell(banner, 0, 1, "NQ moved " + str.tostring(movedPct, "#.##") + "% since the data: consider a refresh", text_color = dark, bgcolor = color.new(#FFB74D, 10), text_size = size.small, text_halign = text.align_left)
        else
            table.cell(banner, 0, 1, "")
//#endregion
